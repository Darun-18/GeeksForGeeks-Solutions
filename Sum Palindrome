class Solution {
    static int isSumPalindrome(int n) {

        for (int i = 0; i <= 5; i++) {

            int temp = n;
            int rev = 0;

            // Reverse n
            while (temp > 0) {
                int rem = temp % 10;
                rev = rev * 10 + rem;
                temp = temp / 10;
            }

            // Already palindrome
            if (n == rev) {
                return n;
            }

            // Add reverse
            n = n + rev;
        }

        return -1;
    }
}
